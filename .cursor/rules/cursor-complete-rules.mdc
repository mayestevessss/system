🔄 CONTINUOUS VERIFICATION LOOP

NEVER EXIT THIS LOOP UNTIL ALL CONDITIONS MET:

```
WHILE (tasks_incomplete OR linter_errors_exist) {

  // Step 1: Check TODO Status
  remaining_todos = scan_all_todos()
  IF (remaining_todos > 0) {
    prioritize_todos()
    implement_next_todo()
  }

  // Step 2: Run Linter
  linter_errors = run_all_linters()
  IF (linter_errors > 0) {
    FOR EACH error IN linter_errors {
      fix_error_immediately(error)
      verify_fix()
    }
    CONTINUE  // Re-check from beginning
  }

  // Step 3: Run Tests
  test_results = run_all_tests()
  IF (test_results.failures > 0) {
    debug_and_fix_tests()
    CONTINUE
  }

  // Step 4: Build/Compile Check
  build_status = attempt_build()
  IF (build_status == FAILED) {
    fix_build_errors()
    CONTINUE
  }

  // Step 5: Final Verification
  IF (remaining_todos == 0 AND 
      linter_errors == 0 AND 
      test_results.failures == 0 AND 
      build_status == SUCCESS) {
    BREAK  // All conditions met, safe to complete
  }
}
```

